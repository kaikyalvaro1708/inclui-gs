#!/bin/bash
set -euxo pipefail

# Script de deploy, chamado pelo pipeline via SSM com o SHA do commit:
#   /usr/local/bin/deploy.sh <tag>
cat > /usr/local/bin/deploy.sh <<'SCRIPT'
#!/bin/bash
set -euxo pipefail
TAG="$1"
IMAGEM="${repositorio}:$TAG"
aws ecr get-login-password --region ${regiao} | docker login --username AWS --password-stdin ${registry}
docker pull "$IMAGEM"
docker rm -f ${container} 2>/dev/null || true
# A imagem roda sem root na porta ${porta}; a EC2 expõe na 80.
docker run -d --name ${container} --restart always -p 80:${porta} \
  --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges \
  "$IMAGEM"
# Apaga as imagens antigas para não encher o disco.
docker image prune -af
SCRIPT
chmod +x /usr/local/bin/deploy.sh

dnf install -y docker
systemctl enable --now docker
usermod -aG docker ec2-user
# O primeiro container sobe pelo pipeline, logo depois do terraform apply.
